# Скопируйте этот файл в ".env" (в этой же папке) и заполните.
# ".env" в git не попадает (см. .gitignore) - сюда можно класть пароли.
# Compose и Visual Studio подхватывают ".env" автоматически.

# Пароль SA для SQL Server. Правила: минимум 8 символов, минимум 3 из 4 видов
# (заглавные, строчные, цифры, символы). Не используйте ; и $ - они ломают строку подключения.
SQL_SA_PASSWORD=YourStrong!Passw0rd

# Секрет подписи JWT: любая случайная строка, минимум 32 символа.
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-characters

# Первый администратор (создаётся при старте, если ещё не существует).
ADMIN_EMAIL=admin@innoshop.local
ADMIN_PASSWORD=Admin12345

# SMTP (Gmail: нужен "пароль приложения", не обычный пароль).
# Если не заполнено, API запустится, но письма отправляться не будут (ошибка в логах).
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_FROM=

# RabbitMQ
# Логин и пароль для подключения к брокеру сообщений
RABBITMQ_USER=innoshop
RABBITMQ_PASSWORD=YourStrongRabbitPassword123!