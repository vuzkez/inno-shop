<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <!-- Required by the EF Core tools: migrations are scaffolded with this project as the
         startup project, which keeps the DbContext resolvable from the real host. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.15">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.15" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="9.0.6" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Inno_Shop.Products.Application\Inno_Shop.Products.Application.csproj" />
    <ProjectReference Include="..\Inno_Shop.Products.Infrastructure\Inno_Shop.Products.Infrastructure.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Points at the secrets file that already holds ConnectionStrings:DefaultConnection
         for InnoShopProducts. Never committed; lives under %APPDATA%\Microsoft\UserSecrets. -->
    <UserSecretsId>c423c0b8-42ec-4f2b-b8bc-b3a0e0adb06c</UserSecretsId>
  </PropertyGroup>

</Project>
