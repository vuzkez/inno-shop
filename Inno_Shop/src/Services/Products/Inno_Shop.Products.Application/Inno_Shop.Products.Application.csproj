<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <!--
      MediatR зафиксирован на 12.5.0 намеренно: начиная с 13.0 пакет распространяется
      под RPL-1.5 (сильный копилефт) либо по платной лицензии. 12.5.0 - последняя
      версия под Apache-2.0. Не обновлять без юридического решения.
    -->
    <PackageReference Include="MediatR" Version="12.5.0" />
    <PackageReference Include="FluentValidation" Version="12.2.0" />
    <PackageReference Include="FluentValidation.DependencyInjectionExtensions" Version="12.2.0" />
  </ItemGroup>

  <ItemGroup>
    <!--
      IApplicationDbContext exposes DbSet<T>, so the Application layer references EF Core.
      This is a deliberate trade-off: no repository layer and no boilerplate, at the cost of
      EF Core leaking into Application.
    -->
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.15" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Inno_Shop.Products.Domain\Inno_Shop.Products.Domain.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
